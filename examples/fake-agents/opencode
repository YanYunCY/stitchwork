#!/usr/bin/env node
// Demo stand-in for OpenCode: mimics `opencode run <prompt>`.
if (process.argv.includes('--version')) { console.log('opencode-fake 0.0.0 (Stitchwork demo stand-in)'); process.exit(0); }
if ((process.env.STITCHWORK_FAKE_RATE_LIMIT ?? '').split(',').includes('opencode')) { console.error('Error: 429 Too Many Requests'); process.exit(1); }
const prompt = process.argv.at(-1) ?? '';
console.log(`🧩 [opencode] ${prompt.slice(0, 80)}`);
