#!/usr/bin/env node
// Demo stand-in for Codex CLI: mimics `codex exec ... <prompt>` plain-text output.
if (process.argv.includes('--version')) { console.log('codex-fake 0.0.0 (Stitchwork demo stand-in)'); process.exit(0); }
if ((process.env.STITCHWORK_FAKE_RATE_LIMIT ?? '').split(',').includes('codex')) { console.error("ERROR: You've hit your usage limit. Try again later."); process.exit(1); }
const prompt = process.argv.at(-1) ?? '';
console.log(`🛠️ [codex] ${prompt.slice(0, 80)}`);
console.log(`tokens used: ${1500 + prompt.length}`);
